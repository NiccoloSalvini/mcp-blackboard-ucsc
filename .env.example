# Blackboard instance
BB_BASE_URL=https://blackboard.unicatt.it

# Stopgap: a token lifted from a logged-in Ultra session. Set this and the server
# works right now, with the permissions of whoever is signed in. It lives for
# minutes, not hours — grab it and use it straight away — so it is for getting
# work done before the
# administrator registers the Application ID below -- not instead of it.
# To grab one: Chrome, logged into Blackboard -> DevTools -> Network -> filter
# "tokeninfo" -> reload a course page -> copy access_token off the request URL.
BB_TOKEN=

# From developer.anthology.com -> your registered application.
# The same Application ID must be registered by the Blackboard administrator
# under Admin > REST API Integrations, bound to your instructor account.
BB_APP_KEY=
BB_APP_SECRET=

# Write protection. Both default to off: without them the server can only read.
# Turn these on deliberately, not by habit.
BB_ALLOW_WRITES=0          # create content, assessments, questions, columns
BB_ALLOW_GRADE_WRITES=0    # post grades to the gradebook (separate on purpose)
